<UserControl x:Class="PDVMottainai.Views.Actions.CancelSaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center">
        <Border Width="68" Height="68" Background="#FCE9DA" CornerRadius="22" HorizontalAlignment="Left">
            <TextBlock Text="!" FontSize="38" FontWeight="Bold" Foreground="#EB7A24"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="HeadingText" Text="Cancelar esta venda?" FontSize="24" FontWeight="Bold" Foreground="#102A43" Margin="0,20,0,8"/>
        <TextBlock x:Name="DescriptionText" Text="Todos os itens bipados serão removidos da venda atual. Esta ação não poderá ser desfeita."
                   FontSize="15" Foreground="#667784" TextWrapping="Wrap" MaxWidth="560"/>
        <Border Background="#FFF8F1" CornerRadius="10" Padding="14" Margin="0,22,0,0">
            <TextBlock x:Name="ActionNoteText" Text="Se deseja remover apenas um item, use “Excluir produto” (F5)."
                       Foreground="#102A43" FontSize="14" TextWrapping="Wrap"/>
        </Border>
    </StackPanel>
</UserControl>
