<UserControl x:Class="PDVMottainai.Views.Actions.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="4,0,4,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Registros de vendas" FontSize="22" FontWeight="Bold" Foreground="#102A43"/>
                <TextBlock Text="A API retorna o resumo e o status dos registros disponíveis."
                           Foreground="#667784" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#EAF1F4" CornerRadius="9" Padding="14,8">
                <TextBlock x:Name="CountTextBlock" Text="0 vendas" Foreground="#102A43" FontWeight="SemiBold"/>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
            <ListView x:Name="HistoryList" Grid.Column="0" BorderThickness="0" Background="Transparent"
                      SelectionChanged="HistoryList_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12"/>
                        <Setter Property="Margin" Value="0,0,10,8"/>
                        <Setter Property="Background" Value="#F5F8FA"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding SaleDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                       Foreground="#667784" FontSize="12"/>
                            <TextBlock Text="{Binding CustomerName}" Foreground="#102A43" FontWeight="Bold"
                                       FontSize="15" Margin="0,5,0,0"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ItemCount, StringFormat={}{0} item(ns)}" Foreground="#667784"/>
                                <TextBlock Grid.Column="1" Text="{Binding DiscountTotal, StringFormat={}{0:C}}"
                                           Foreground="#EB7A24" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Border Grid.Column="1" Background="#F5F8FA" CornerRadius="14" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DetailCustomer" Text="Selecione uma venda" FontSize="21"
                                   FontWeight="Bold" Foreground="#102A43"/>
                        <TextBlock x:Name="DetailDate" Text="Detalhes completos aparecerão aqui."
                                   Foreground="#667784" Margin="0,4,0,0"/>
                        <TextBlock x:Name="DetailCpf" Foreground="#667784" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,16,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="SEM DESCONTO" FontSize="10" FontWeight="Bold" Foreground="#667784"/>
                            <TextBlock x:Name="DetailRegularTotal" Text="—" FontWeight="SemiBold" Foreground="#102A43" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="COM DESCONTO" FontSize="10" FontWeight="Bold" Foreground="#667784"/>
                            <TextBlock x:Name="DetailDiscountTotal" Text="—" FontWeight="SemiBold" Foreground="#102A43" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="VALOR GANHO" FontSize="10" FontWeight="Bold" Foreground="#667784"/>
                            <TextBlock x:Name="DetailEarned" Text="—" FontWeight="SemiBold" Foreground="#EB7A24" Margin="0,4,0,0"/></StackPanel>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Itens" FontSize="15" FontWeight="Bold" Foreground="#102A43" Margin="0,0,0,6"/>
                        <ListView x:Name="DetailItemsList" Grid.Row="1" BorderThickness="0" Background="Transparent">
                            <ListView.ItemTemplate><DataTemplate>
                                <Grid Margin="4,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="{Binding Name}" Foreground="#102A43" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Sku}" Foreground="#667784" FontSize="12" Margin="0,2,0,0"/></StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding LineTotal, StringFormat={}{0:C}}"
                                               Foreground="#102A43" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock x:Name="PaymentDetailsText" Text="Pagamentos: —" Foreground="#667784" TextWrapping="Wrap"/>
                        <TextBlock x:Name="InvoiceText" Text="CPF na nota: —" Foreground="#667784" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock x:Name="EmptyStateText" Grid.Column="0" Text="Nenhum registro de venda retornado pela API."
                       Foreground="#82919A" FontSize="15" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
