<UserControl x:Class="PDVMottainai.Views.Actions.FinalizeShiftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="pt-BR">
    <Grid>
        <ScrollViewer x:Name="SummaryPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="2,0,8,4">
                <Border Background="#102A43" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="EmployeeText" Text="Funcionário" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="ShiftPeriodText" Text="Turno" FontSize="13" Foreground="#D7E3EA" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="4" Margin="0,0,0,14">
                    <Border Background="#EAF1F4" CornerRadius="11" Padding="16" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="VENDAS" FontSize="11" FontWeight="Bold" Foreground="#667784"/>
                            <TextBlock x:Name="SalesCountText" Text="0" FontSize="25" FontWeight="Bold" Foreground="#102A43" Margin="0,5,0,0"/></StackPanel>
                    </Border>
                    <Border Background="#EAF1F4" CornerRadius="11" Padding="16" Margin="4,0">
                        <StackPanel><TextBlock Text="ITENS VENDIDOS" FontSize="11" FontWeight="Bold" Foreground="#667784"/>
                            <TextBlock x:Name="ItemsSoldText" Text="0" FontSize="25" FontWeight="Bold" Foreground="#102A43" Margin="0,5,0,0"/></StackPanel>
                    </Border>
                    <Border Background="#EAF1F4" CornerRadius="11" Padding="16" Margin="4,0">
                        <StackPanel><TextBlock Text="TICKET MÉDIO" FontSize="11" FontWeight="Bold" Foreground="#667784"/>
                            <TextBlock x:Name="AverageTicketText" Text="R$ 0,00" FontSize="21" FontWeight="Bold" Foreground="#102A43" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                    <Border Background="#FFF0E3" CornerRadius="11" Padding="16" Margin="8,0,0,0">
                        <StackPanel><TextBlock Text="TEMPO DE TURNO" FontSize="11" FontWeight="Bold" Foreground="#667784"/>
                            <TextBlock x:Name="DurationText" Text="00h 00min" FontSize="21" FontWeight="Bold" Foreground="#102A43" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="#F5F8FA" CornerRadius="12" Padding="18" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="VENDAS POR FORMA DE PAGAMENTO" FontSize="12" FontWeight="Bold" Foreground="#667784" Margin="0,0,0,12"/>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Débito" Foreground="#102A43"/><TextBlock x:Name="DebitTotalText" Grid.Column="1" Text="R$ 0,00" FontWeight="Bold" Foreground="#102A43"/></Grid>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Crédito" Foreground="#102A43"/><TextBlock x:Name="CreditTotalText" Grid.Column="1" Text="R$ 0,00" FontWeight="Bold" Foreground="#102A43"/></Grid>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Pix" Foreground="#102A43"/><TextBlock x:Name="PixTotalText" Grid.Column="1" Text="R$ 0,00" FontWeight="Bold" Foreground="#102A43"/></Grid>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Dinheiro" Foreground="#102A43"/><TextBlock x:Name="CashSalesTotalText" Grid.Column="1" Text="R$ 0,00" FontWeight="Bold" Foreground="#102A43"/></Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#F5F8FA" CornerRadius="12" Padding="18" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="CONSOLIDADO DAS VENDAS" FontSize="12" FontWeight="Bold" Foreground="#667784" Margin="0,0,0,12"/>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Total sem descontos" Foreground="#102A43"/><TextBlock x:Name="RegularTotalText" Grid.Column="1" Text="R$ 0,00" FontWeight="SemiBold" Foreground="#102A43"/></Grid>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Total vendido" Foreground="#102A43"/><TextBlock x:Name="PaidTotalText" Grid.Column="1" Text="R$ 0,00" FontWeight="Bold" FontSize="17" Foreground="#102A43"/></Grid>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Economia em promoções" Foreground="#667784"/><TextBlock x:Name="PromotionSavingsText" Grid.Column="1" Text="R$ 0,00" FontWeight="Bold" Foreground="#EB7A24"/></Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="#EAF1F4" CornerRadius="12" Padding="18" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="CONFERÊNCIA DO CAIXA" FontSize="12" FontWeight="Bold" Foreground="#667784" Margin="0,0,0,12"/>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Dinheiro contado" Foreground="#102A43"/><TextBlock x:Name="CountedCashText" Grid.Column="1" Text="R$ 0,00" FontWeight="Bold" Foreground="#102A43"/></Grid>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Saldo esperado no sistema" Foreground="#102A43"/><TextBlock x:Name="ExpectedCashText" Grid.Column="1" Text="R$ 0,00" FontWeight="SemiBold" Foreground="#102A43"/></Grid>
                            <TextBlock x:Name="CashDifferenceText" Text="Sem diferença" FontSize="18" FontWeight="Bold" Foreground="#187344" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#FFF8F1" CornerRadius="12" Padding="18" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="MOVIMENTAÇÕES DE DINHEIRO" FontSize="12" FontWeight="Bold" Foreground="#667784" Margin="0,0,0,12"/>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Entradas" Foreground="#102A43"/><TextBlock x:Name="CashAddedText" Grid.Column="1" Text="R$ 0,00" FontWeight="SemiBold" Foreground="#187344"/></Grid>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Retiradas" Foreground="#102A43"/><TextBlock x:Name="CashWithdrawnText" Grid.Column="1" Text="R$ 0,00" FontWeight="SemiBold" Foreground="#B42318"/></Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="#F5F8FA" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="23" Background="#FCE6D5" VerticalAlignment="Center">
                            <TextBlock Text="★" FontSize="24" Foreground="#EB7A24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                            <TextBlock Text="PRODUTO MAIS VENDIDO" FontSize="11" FontWeight="Bold" Foreground="#667784"/>
                            <TextBlock x:Name="BestSellingProductText" Text="Nenhum produto vendido" FontSize="17" FontWeight="Bold" Foreground="#102A43" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock x:Name="BestSellingQuantityText" Text="0 unidades" FontSize="15" FontWeight="Bold" Foreground="#187344" TextAlignment="Right"/>
                            <TextBlock x:Name="BestSellingRevenueText" Text="R$ 0,00" FontSize="13" Foreground="#667784" Margin="0,3,0,0" TextAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="ClosedShiftPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
            <TextBlock x:Name="ClosedStateTitleText" Text="Turno encerrado" FontSize="24" FontWeight="Bold" Foreground="#102A43" TextAlignment="Center"/>
            <TextBlock x:Name="ClosedStateDescriptionText" Text="Não é possível iniciar outra venda neste turno." FontSize="15" Foreground="#667784" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>