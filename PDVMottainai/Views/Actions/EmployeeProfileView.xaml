<UserControl x:Class="PDVMottainai.Views.Actions.EmployeeProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <Border Background="#102A43" CornerRadius="14" Padding="22" Margin="0,0,0,16">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="EmployeeName" Text="Funcionário" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="EmployeePosition" Text="Perfil do turno" FontSize="13" Foreground="#D7E3EA" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Columns="3" Rows="1" Margin="0,0,0,16">
                <Border Background="#FFF3E8" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="VENDAS NESTE TURNO" FontSize="10" FontWeight="Bold" Foreground="#9A4D10"/>
                        <TextBlock x:Name="SalesCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#102A43" Margin="0,5,0,0"/></StackPanel>
                </Border>
                <Border Background="#EAF1F4" CornerRadius="12" Padding="16" Margin="4,0">
                    <StackPanel><TextBlock Text="INÍCIO DO TURNO" FontSize="10" FontWeight="Bold" Foreground="#667784"/>
                        <TextBlock x:Name="ShiftStart" Text="--" FontSize="17" FontWeight="Bold" Foreground="#102A43" Margin="0,8,0,0"/></StackPanel>
                </Border>
                <Border Background="#EAF1F4" CornerRadius="12" Padding="16" Margin="8,0,0,0">
                    <StackPanel><TextBlock Text="TEMPO NO TURNO" FontSize="10" FontWeight="Bold" Foreground="#667784"/>
                        <TextBlock x:Name="ShiftDuration" Text="--" FontSize="17" FontWeight="Bold" Foreground="#102A43" Margin="0,8,0,0"/></StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="DADOS DO FUNCIONÁRIO" FontSize="12" FontWeight="Bold" Foreground="#EB7A24" Margin="2,0,0,8"/>
            <Border Background="White" BorderBrush="#E1E8EC" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,15"><TextBlock Text="CPF" Foreground="#667784" FontSize="11"/><TextBlock x:Name="EmployeeCpf" Foreground="#102A43" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="14,0,0,15"><TextBlock Text="E-MAIL" Foreground="#667784" FontSize="11"/><TextBlock x:Name="EmployeeEmail" Foreground="#102A43" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,15"><TextBlock Text="TELEFONE" Foreground="#667784" FontSize="11"/><TextBlock x:Name="EmployeePhone" Foreground="#102A43" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="14,0,0,15"><TextBlock Text="LOJA" Foreground="#667784" FontSize="11"/><TextBlock x:Name="StoreName" Foreground="#102A43" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,14,15"><TextBlock Text="CÓDIGO DO FUNCIONÁRIO" Foreground="#667784" FontSize="11"/><TextBlock x:Name="EmployeeId" Foreground="#102A43" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="14,0,0,15"><TextBlock Text="CARGO (CÓDIGO)" Foreground="#667784" FontSize="11"/><TextBlock x:Name="RoleId" Foreground="#102A43" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,14,0"><TextBlock Text="ADMISSÃO" Foreground="#667784" FontSize="11"/><TextBlock x:Name="HireDate" Foreground="#102A43" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="STATUS" Foreground="#667784" FontSize="11"/><TextBlock x:Name="EmployeeStatus" Foreground="#102A43" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                </Grid>
            </Border>
            <TextBlock x:Name="DataNotice" Text="Os dados exibidos são os disponíveis no cadastro atual do funcionário."
                       Foreground="#667784" FontSize="11" TextWrapping="Wrap" Margin="2,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
