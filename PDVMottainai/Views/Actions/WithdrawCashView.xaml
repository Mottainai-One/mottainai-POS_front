<UserControl x:Class="PDVMottainai.Views.Actions.WithdrawCashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Retirada de numerário" FontSize="22" FontWeight="Bold" Foreground="#102A43"/>
        <TextBlock Text="Registre a saída de dinheiro do caixa e informe o motivo."
                   Foreground="#667784" FontSize="14" Margin="0,4,0,20"/>
        <TextBlock Text="VALOR DA RETIRADA" FontSize="11" FontWeight="Bold" Foreground="#667784" Margin="2,0,0,6"/>
        <TextBox x:Name="AmountTextBox" Height="48" FontSize="20" ToolTip="Ex.: 50,00"/>
        <TextBlock Text="MOTIVO (OPCIONAL)" FontSize="11" FontWeight="Bold" Foreground="#667784" Margin="2,16,0,6"/>
        <TextBox x:Name="ReasonTextBox" Height="44" ToolTip="Ex.: pagamento de fornecedor"/>
        <TextBlock x:Name="FeedbackText" Foreground="#BA4E21" FontSize="13" Margin="2,14,0,0"/>
        <TextBlock x:Name="BalanceText" Text="Saldo registrado: R$ 0,00"
                   Foreground="#667784" FontSize="13" Margin="2,16,0,0"/>
    </StackPanel>
</UserControl>
