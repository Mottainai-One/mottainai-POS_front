<UserControl x:Class="PDVMottainai.Views.Actions.AddCashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Entrada de numerário" FontSize="22" FontWeight="Bold" Foreground="#102A43"/>
        <TextBlock Text="Registre o valor colocado no caixa e informe a origem."
                   Foreground="#667784" FontSize="14" Margin="0,4,0,20"/>
        <TextBlock Text="VALOR DA ENTRADA" FontSize="11" FontWeight="Bold" Foreground="#667784" Margin="2,0,0,6"/>
        <TextBox x:Name="AmountTextBox" Height="48" FontSize="20" ToolTip="Ex.: 100,00"/>
        <TextBlock Text="ORIGEM (OPCIONAL)" FontSize="11" FontWeight="Bold" Foreground="#667784" Margin="2,16,0,6"/>
        <TextBox x:Name="ReasonTextBox" Height="44" ToolTip="Ex.: troco inicial"/>
        <TextBlock x:Name="FeedbackText" Foreground="#BA4E21" FontSize="13" Margin="2,14,0,0"/>
        <TextBlock x:Name="BalanceText" Text="Saldo registrado: R$ 0,00"
                   Foreground="#667784" FontSize="13" Margin="2,16,0,0"/>
    </StackPanel>
</UserControl>
