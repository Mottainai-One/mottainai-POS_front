<UserControl x:Class="PDVMottainai.Views.Actions.CashCountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="pt-BR">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="2,0,2,18">
            <TextBlock Text="Contagem cega do caixa" FontSize="22" FontWeight="Bold" Foreground="#102A43"/>
            <TextBlock Text="Conte o dinheiro físico e informe o total. O saldo esperado só será mostrado depois desta etapa."
                       FontSize="14" Foreground="#667784" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#F5F8FA" CornerRadius="14" Padding="28">
            <StackPanel VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Center">
                <TextBlock Text="DINHEIRO CONTADO NO CAIXA" FontSize="12" FontWeight="Bold" Foreground="#667784"/>
                <TextBlock Text="Some cédulas e moedas antes de conferir o sistema."
                           FontSize="14" Foreground="#667784" Margin="0,6,0,14" TextWrapping="Wrap"/>
                <TextBox x:Name="CountedCashTextBox" Height="56" FontSize="24" Padding="16,10"
                         VerticalContentAlignment="Center"/>
                <TextBlock x:Name="FeedbackTextBlock" Foreground="#B42318" FontSize="13"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>