<UserControl x:Class="PDVMottainai.Views.Actions.ConsultProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Encontre um produto pelo nome, SKU ou código de barras."
                           FontSize="15" Foreground="#667784" Margin="0,0,0,8"/>
            <TextBox x:Name="SearchTextBox" Height="44" Margin="0,0,10,0" VerticalContentAlignment="Center"
                     TextChanged="SearchTextBox_TextChanged"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#EB7A24" CornerRadius="9" Padding="18,9">
                <TextBlock x:Name="CountText" Text="CATÁLOGO" Foreground="#102A43" FontWeight="Bold" VerticalAlignment="Center"/>
            </Border>
        </Grid>
        <ListView x:Name="ProductsList" Grid.Row="1" Margin="0,0,16,0" BorderThickness="0"
                  SelectionChanged="ProductsList_SelectionChanged"
                  Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                    <Setter Property="Background" Value="#F5F8FA"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#102A43" FontSize="15"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Sku}" Foreground="#667784" Margin="0,4,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Border Grid.Column="1" Grid.Row="1" Background="#F5F8FA" CornerRadius="14" Padding="24">
            <StackPanel x:Name="DetailPanel" VerticalAlignment="Top">
                <TextBlock x:Name="DetailName" Text="Selecione um produto" FontSize="24" FontWeight="Bold"
                           Foreground="#102A43" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock x:Name="DetailBrand" Text="Os detalhes aparecerão aqui." FontSize="15"
                           Foreground="#667784" TextWrapping="Wrap"/>
                <Border Height="1" Background="#DCE6EB" Margin="0,18,0,14"/>
                <TextBlock Text="SKU" FontSize="11" FontWeight="Bold" Foreground="#82919A"/>
                <TextBlock x:Name="DetailSku" Text="—" FontSize="16" Foreground="#102A43" Margin="0,3,0,12"/>
                <TextBlock Text="Código de barras" FontSize="11" FontWeight="Bold" Foreground="#82919A"/>
                <TextBlock x:Name="DetailBarcode" Text="—" FontSize="16" Foreground="#102A43" Margin="0,3,0,12"/>
                <TextBlock Text="Preço normal" FontSize="11" FontWeight="Bold" Foreground="#82919A"/>
                <TextBlock x:Name="DetailRegularPrice" Text="—" FontSize="16" Foreground="#102A43" Margin="0,3,0,12"/>
                <TextBlock Text="Preço promocional" FontSize="11" FontWeight="Bold" Foreground="#82919A"/>
                <TextBlock x:Name="DetailDiscountPrice" Text="—" FontSize="16" Foreground="#EB7A24" FontWeight="Bold" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
