<UserControl x:Class="PDVMottainai.Views.Actions.StartSaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Uma nova venda começa aqui" FontSize="22" FontWeight="Bold" Foreground="#102A43"/>
        <UniformGrid Grid.Row="1" Columns="2" Margin="0,22,0,0">
            <Border Background="#EAF1F4" CornerRadius="12" Padding="20" Margin="0,0,10,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="01  ·  NOVA VENDA" Foreground="#EB7A24" FontWeight="Bold" FontSize="12"/>
                    <TextBlock Text="Pronto para atender" Foreground="#102A43" FontWeight="Bold" FontSize="20" Margin="0,12,0,5"/>
                    <TextBlock x:Name="DescriptionText" Text="A venda atual será iniciada. Você poderá bipar produtos e vincular o cliente na tela principal."
                               Foreground="#667784" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Background="#FFF8F1" CornerRadius="12" Padding="20" Margin="10,0,0,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ATALHO" Foreground="#667784" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="F1" Foreground="#102A43" FontWeight="Bold" FontSize="42" Margin="0,8"/>
                    <TextBlock Text="Bipe o primeiro produto para adicionar um item à venda."
                               Foreground="#667784" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </UniformGrid>
    </Grid>
</UserControl>
