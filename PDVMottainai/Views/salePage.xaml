<Page x:Class="PDVMottainai.Views.salePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:PDVMottainai.Views"
      mc:Ignorable="d"
      Background="#FFF8F1"
      Focusable="True"
      Loaded="SalePage_Loaded"
      Unloaded="SalePage_Unloaded"
      PreviewKeyDown="SalePage_PreviewKeyDown"
      Title="salePage"
>

    <Page.Resources>
        <Style x:Key="CleanTextBoxStyle" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <!-- Borda do TextBox -->
                            <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                                <!-- Conteúdo digitado -->
                                <ScrollViewer x:Name="PART_ContentHost" 
                                          VerticalAlignment="Center"
                                          Margin="4,0,0,0" />
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Remove ou altera a cor da borda quando ganha foco (substitui o azul padrão) -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="Transparent"/>
                                <!-- Se quiser remover totalmente a borda ao focar, mude para "Transparent" ou mude o BorderThickness para 0 -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="TransparentButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FooterActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCE6EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="#EB7A24"/>
                                <Setter TargetName="ActionBorder" Property="Background" Value="#FFF8F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Estilo para o cartão (borda com sombra) -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect 
                        Color="Black" 
                        Direction="315" 
                        ShadowDepth="0" 
                        BlurRadius="5" 
                        Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para os títulos dentro dos cartões -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#555555"/>
        </Style>

        <!-- Estilo para os valores (textos em negrito) dentro dos cartões -->
        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Grid 
            Grid.Row="0" 
            Background="#102A43">

            <Image
                Source="/IMG/mottainai.png"
                HorizontalAlignment="Left"
                Margin="20,7,0,7"/>

            <TextBlock x:Name="txtStore"
                Margin="70,0,0,0"
                FontSize="25"
                VerticalAlignment="Center"
                FontFamily="./Fonts/#DM Sans"
                Foreground="White"
                FontWeight="SemiBold"/>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,30,0">
                <TextBlock x:Name="txtCurrentTime" Text="--:--:--" TextAlignment="Right"
                           FontSize="21" Foreground="White" FontWeight="Bold"/>
                <TextBlock x:Name="txtCurrentDate" Text="--/--/----" TextAlignment="Right"
                           FontSize="12" Foreground="#D7E3EA" Margin="0,1,0,0"/>
            </StackPanel>
        </Grid>

        <!-- CARTÕES DE INFORMAÇÃO (LINHA 1) -->
        <Grid 
            Grid.Row="1" 
            Background="#FFF8F1">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Grade que organiza os cinco cartões -->
            <Grid 
                Grid.Row="1" 
                Margin="10,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <!-- CARTÃO 1: Nº da venda -->
                <Border 
                    Grid.Column="0" 
                    Style="{StaticResource CardStyle}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image 
                            Source="/IMG/CartIcon.png" 
                            Margin="15,10,10,10" 
                            VerticalAlignment="Center"/>

                        <StackPanel 
                            Grid.Column="1" 
                            VerticalAlignment="Center">

                            <TextBlock 
                                Text="N° venda" 
                                Style="{StaticResource CardTitleStyle}"/>

                            <TextBlock x:Name="txtNumSale" 
                                Style="{StaticResource CardValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARTÃO 2: CPF do cliente -->
                <Border 
                    Grid.Column="1" 
                    Style="{StaticResource CardStyle}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image 
                            Source="/IMG/documentIcon.png" 
                            Margin="15,10,10,10" 
                            VerticalAlignment="Center"/>

                        <StackPanel 
                            Grid.Column="1" 
                            VerticalAlignment="Center">

                            <TextBlock 
                                Text="CPF do cliente" 
                                Style="{StaticResource CardTitleStyle}"/>

                            <TextBlock x:Name="txtNumSal" 
                                Text="Não informado" 
                                Style="{StaticResource CardValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARTÃO 3: Nome do cliente -->
                <Border 
                    Grid.Column="2" 
                    Style="{StaticResource CardStyle}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image 
                            Source="/IMG/userIcon.png" 
                            Margin="15,10,10,10" 
                            VerticalAlignment="Center"/>

                        <StackPanel 
                            Grid.Column="1" 
                            VerticalAlignment="Center">

                            <TextBlock 
                                Text="Nome do cliente" 
                                Style="{StaticResource CardTitleStyle}"/>

                            <TextBlock x:Name="txtNumSa" 
                                Text="Consumidor não identificado" 
                                Style="{StaticResource CardValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARTÃO 4: Nível do cliente -->
                <Border 
                    Grid.Column="3" 
                    Style="{StaticResource CardStyle}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image 
                            Source="/IMG/podiumIcon.png" 
                            Margin="15,10,10,10" 
                            VerticalAlignment="Center"/>

                        <StackPanel 
                            Grid.Column="1" 
                            VerticalAlignment="Center">

                            <TextBlock 
                                Text="Nível do cliente" 
                                Style="{StaticResource CardTitleStyle}"/>

                            <TextBlock x:Name="txtNumS" 
                                Text="Não identificado" 
                                Style="{StaticResource CardValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARTÃO 5: Status da venda -->
                <Border x:Name="saleStatusCard"
                    Grid.Column="4" 
                    Style="{StaticResource CardStyle}"
                    Background="#E6F0FA">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image x:Name="saleStatusIcon" Width="44" Height="44" Stretch="Uniform"
                               Margin="12,9,10,9" VerticalAlignment="Center"/>

                        <TextBlock x:Name="txtNum" 
                            Grid.Column="1" 
                            Text="Venda em andamento" 
                            TextWrapping="Wrap" 
                            VerticalAlignment="Center" 
                            Style="{StaticResource CardValueStyle}"
                            Foreground="#2864A4"/>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- CORPO -->
        <Grid 
            Grid.Row="2" 
            Background="#FFF8F1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="8*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                 >
                <Grid>

                    <Grid>
                        <Border Grid.Column="1"  
                                Style="{StaticResource CardStyle}"
                                Margin="20,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1.5*"/>
                                    <RowDefinition Height="2*"/>
                                    <RowDefinition Height="1.4*"/>
                                    <RowDefinition Height="4.6*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="2*"/>
                                        <RowDefinition Height="3*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <TextBlock
                                            Text="Produto"
                                            HorizontalAlignment="Left"
                                            FontSize="17"
                                            Margin="24,3,0,0"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Foreground="#102A43"
                                            />
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="10*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" 
                                                BorderBrush="LightGray" 
                                                BorderThickness="1"
                                                Margin="24,2,5,5"
                                                CornerRadius="10">
                                            <TextBox x:Name="formBarcode"
                                                Background="White"
                                                     Style="{StaticResource CleanTextBoxStyle}"
                                                     BorderBrush="Transparent"
                                                     FontSize="20"
                                                     VerticalAlignment="Center"
                                                     Margin="10,0,10,0"
                                                     TextChanged="formBarcode_TextChanged"
                                                      PreviewKeyDown="formBarcode_PreviewKeyDown"
                                                     MaxLength="13"
                                                     />
                                        </Border>
                                        <Border Grid.Column="1" 
                                                Background="#102A43"
                                                Margin="0,2,10,5"
                                                CornerRadius="10"
                                                BorderBrush="LightGray"
                                                BorderThickness="1"
                                                >
                                            <Button BorderThickness="0"
                                                    Background="#102A43"
                                                    Margin="3,3,3,3"
                                                    Click="SearchBarcode_Click"
                                                    Style="{StaticResource TransparentButton}">
                                                <Image Source="/IMG/searchIcon.png"
                                                       Margin="3,3,3,3"/>
                                            </Button>

                                        </Border>
                                    </Grid>

                                </Grid>
                                <Border Grid.Row="1" Background="#EAF1F4"
                                        Margin="24,5,10,0" CornerRadius="10" Padding="14,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="txtProductName" Text="-"
                                                   FontSize="18" FontWeight="Bold"
                                                   Foreground="#102A43" TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,8" VerticalAlignment="Center"/>

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Margin="0,0,12,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.ColumnSpan="2" Text="Código de barras (Ctrl+B)"
                                                           FontSize="12" Foreground="#667784"/>
                                                <TextBlock x:Name="txtBarCode" Grid.Row="1" Text="-"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="#102A43" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Row="1" Grid.Column="1" Width="28" Height="28"
                                                        Margin="8,2,0,0" Padding="4"
                                                        Click="CopyBarcode_Click"
                                                        Focusable="False"
                                                        Style="{StaticResource TransparentButton}"
                                                        ToolTip="Copiar código de barras (Ctrl+B)">
                                                    <Image Source="/IMG/copyIcon.png" Stretch="Uniform"/>
                                                </Button>
                                            </Grid>

                                            <Grid Grid.Column="1" Margin="12,0,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.ColumnSpan="2" Text="SKU do produto (Ctrl+S)"
                                                           FontSize="12" Foreground="#667784"/>
                                                <TextBlock x:Name="txtSkuProduct" Grid.Row="1" Text="-"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="#102A43" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Row="1" Grid.Column="1" Width="28" Height="28"
                                                        Margin="8,2,0,0" Padding="4"
                                                        Click="CopySku_Click"
                                                        Focusable="False"
                                                        Style="{StaticResource TransparentButton}"
                                                        ToolTip="Copiar SKU (Ctrl+S)">
                                                    <Image Source="/IMG/copyIcon.png" Stretch="Uniform"/>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="2" Margin="24,5,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="/IMG/wifiIcon.png" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="ConnectionIndicator" Width="10" Height="10" Fill="#EB7A24" Margin="0,0,12,0"/>
                                            <TextBlock x:Name="ConnectionTitle" Text="Verificando conexão..." FontSize="18" FontWeight="Medium"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ConnectionSubtitle" Text="Consultando acesso à internet" FontSize="13" Margin="22,3,8,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="3" Margin="24,4,10,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1.1*"/>
                                        <RowDefinition Height="1.1*"/>
                                        <RowDefinition Height="2.8*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtSecondaryLabel" Text="Valor total sem desconto" FontSize="15" Foreground="#666666"/>
                                        <TextBlock x:Name="txtSecondaryValue" Text="R$ 0,00" FontSize="20" Margin="0,4,0,0" Foreground="#102A43"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtGainLabel" Text="Valor ganho" FontSize="15" Foreground="#666666"/>
                                        <TextBlock x:Name="txtGainValue" Text="R$ 0,00" FontSize="20" Margin="0,4,0,0" Foreground="#EB7A24"/>
                                    </StackPanel>
                                    <Border Grid.Row="2" Background="#EAF1F4" CornerRadius="10" Padding="18,14">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="txtHeroLabel" Text="Valor total com desconto" FontSize="18" FontWeight="Medium"/>
                                            <TextBlock x:Name="txtHeroValue" Text="R$ 0,00" FontSize="42" Margin="0,8,0,0"
                                                       FontWeight="Bold" Foreground="#102A43"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

            </Border>
            <Border Grid.Column="1"
                    Style="{StaticResource CardStyle}"
                    Margin="5,0,20,1">
                <Grid Margin="18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Itens da venda" FontSize="18" FontWeight="Bold"
                               Foreground="#102A43" Margin="10,3,0,12"
                               VerticalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="-6"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <Grid Grid.Row="1" Margin="4,0,4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="0.6*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Produto" FontSize="15" FontWeight="SemiBold" Foreground="#666666"/>
                        <TextBlock Grid.Column="1" Text="Código" FontSize="15" FontWeight="SemiBold" Foreground="#666666"/>
                        <TextBlock Grid.Column="2" Text="SKU" FontSize="15" FontWeight="SemiBold" Foreground="#666666"/>
                        <TextBlock Grid.Column="3" Text="Preço normal" FontSize="15" FontWeight="SemiBold" Foreground="#666666"
                                   Margin="12,0,0,0"/>
                        <TextBlock Grid.Column="4" Text="Com desconto" FontSize="15" FontWeight="SemiBold" Foreground="#666666"
                                   Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="5" Text="Qtd." FontSize="15" FontWeight="SemiBold" Foreground="#666666"/>
                    </Grid>
                    <ListView x:Name="scannedProductsList" Grid.Row="2"
                              BorderThickness="0" Background="Transparent"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="4,10"/>
                                <Setter Property="BorderBrush" Value="#DCE6EB"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="0.6*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Product.Name}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="#102A43" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Product.Barcode}" FontSize="15"
                                               VerticalAlignment="Center" Foreground="#444444"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Product.Sku}" FontSize="15"
                                               VerticalAlignment="Center" Foreground="#444444"/>
                                    <TextBlock Grid.Column="3" Text="{Binding RegularUnitPrice, StringFormat={}{0:C}}" FontSize="15"
                                               Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#444444"/>
                                    <TextBlock Grid.Column="4" Text="{Binding EligibleDiscountPrice, StringFormat={}{0:C}, TargetNullValue=—}" FontSize="15"
                                               Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#EB7A24" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Quantity}" FontSize="15"
                                               TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>


        <!-- RODAPÉ -->
        <Grid 
            Grid.Row="3" 
            Background="#FFF8F1"
            Margin="0,10,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Tag="StartSale" Click="FooterAction_Click" Style="{StaticResource FooterActionButtonStyle}" Background="#E8F5EC" BorderBrush="#187344" BorderThickness="2" Margin="20,0,0,15">
                <StackPanel><TextBlock Text="F1" Foreground="#187344" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/><TextBlock Text="Iniciar venda" Foreground="#187344" FontSize="15" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
            </Button>
            <Button Grid.Column="1" Tag="CancelSale" Click="FooterAction_Click" Style="{StaticResource FooterActionButtonStyle}" Background="#FDECEC" BorderBrush="#B42318" BorderThickness="2" Margin="10,0,0,15">
                <StackPanel><TextBlock Text="F2" Foreground="#B42318" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/><TextBlock Text="Cancelar venda" Foreground="#B42318" FontSize="15" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
            </Button>
            <Button Grid.Column="2" Tag="ConsultProduct" Click="FooterAction_Click" Style="{StaticResource FooterActionButtonStyle}" Margin="10,0,0,15">
                <StackPanel><TextBlock Text="F3" Foreground="#EB7A24" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Consultar produto" Foreground="#102A43" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
            </Button>
            <Button Grid.Column="3" Tag="FinalizeSale" Click="FooterAction_Click" Style="{StaticResource FooterActionButtonStyle}" Margin="10,0,0,15">
                <StackPanel><TextBlock Text="F4" Foreground="#EB7A24" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Simular pagamento" Foreground="#102A43" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
            </Button>
            <Button Grid.Column="4" Tag="RemoveProduct" Click="FooterAction_Click" Style="{StaticResource FooterActionButtonStyle}" Margin="10,0,0,15">
                <StackPanel><TextBlock Text="F5" Foreground="#EB7A24" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Excluir produto" Foreground="#102A43" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
            </Button>
            <Button Grid.Column="5" Tag="SalesHistory" Click="FooterAction_Click" Style="{StaticResource FooterActionButtonStyle}" Margin="10,0,0,15">
                <StackPanel><TextBlock Text="F6" Foreground="#EB7A24" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Histórico de vendas" Foreground="#102A43" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
            </Button>
            <Button Grid.Column="6" Tag="Promotions" Click="FooterAction_Click" Style="{StaticResource FooterActionButtonStyle}" Margin="10,0,0,15">
                <StackPanel><TextBlock Text="F7" Foreground="#EB7A24" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Promoções" Foreground="#102A43" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
