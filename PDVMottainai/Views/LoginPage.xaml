<Page x:Class="PDVMottainai.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" Title="LoginPage" x:Name="Login" Background="#FFF8F1">
    <Page.Resources>
        <Style x:Key="BrandLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Foreground" Value="#EB7A24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="InputTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="34"/>
        </Style>
        <Style x:Key="InputPasswordBox" TargetType="PasswordBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>
        <Style x:Key="StoreComboBox" TargetType="ComboBox" BasedOn="{StaticResource InputComboBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" Margin="0,0,4,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              RecognizesAccessKey="True"/>
                            <ToggleButton Grid.Column="1" Focusable="False" IsTabStop="False" ClickMode="Press"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#667784"
                                                  Width="8" Height="4" Stretch="Fill"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" Placement="Bottom"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="White" BorderBrush="#DCE6EB" BorderThickness="1"
                                        CornerRadius="8" MaxHeight="260" MinWidth="180">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="0.95*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#102A43" CornerRadius="0,36,36,0">
            <Grid ClipToBounds="True">
                <Ellipse Width="440" Height="440" Fill="#183C5B" Opacity="0.52"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-190,-185,0,0"/>
                <Ellipse Width="300" Height="300" Fill="#EB7A24" Opacity="0.12"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-120,-100"/>
                <Grid Margin="48,40,40,38">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/IMG/mottainai.png" Width="72" Height="72" Stretch="Uniform"/>
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="mottainai" FontSize="29" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="PDV · OPERAÇÃO" FontSize="12" FontWeight="Bold" Foreground="#F4A261"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="500" HorizontalAlignment="Left">
                        <Border Background="#EB7A24" CornerRadius="20" Padding="14,7" HorizontalAlignment="Left">
                            <TextBlock Text="UM VAREJO COM PROPÓSITO" Foreground="#102A43" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="Cada escolha conta."
                                   Foreground="White" FontSize="48" FontWeight="Bold"
                                   TextWrapping="Wrap" Margin="0,20,0,8"/>
                        <TextBlock Text="Acesse seu caixa e transforme cada atendimento em uma experiência mais consciente."
                                   Foreground="#D7E3EA" FontSize="16" LineHeight="24"
                                   TextWrapping="Wrap" MaxWidth="430"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="MOTTAINAI  ·  OPERAÇÃO CONSCIENTE"
                               Foreground="#9FB3C2" FontSize="10" FontWeight="SemiBold"/>
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="680" Margin="24,24">
                <Border Background="White" CornerRadius="24" BorderBrush="#E6E8E8" BorderThickness="1"
                        Padding="48" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="ACESSO AO CAIXA" FontSize="10" FontWeight="Bold"
                                   Foreground="#EB7A24"/>
                        <TextBlock Text="Bem-vinda de volta" FontSize="29" FontWeight="Bold"
                                   Foreground="#102A43" Margin="0,9,0,5"/>
                        <TextBlock Text="Entre com seu acesso para iniciar o turno."
                                   FontSize="14" Foreground="#667784" TextWrapping="Wrap"/>

                        <Border x:Name="LoginErrorPanel" Background="#FFF0E2" CornerRadius="9" Padding="11"
                                Margin="0,18,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="txtMsg" Foreground="#9A3412" FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="E-mail ou usuário" FontSize="12" FontWeight="Bold"
                                   Foreground="#34495A" Margin="0,22,0,7"/>
                        <Border Background="#F8FAFC" BorderBrush="#DCE6EB" BorderThickness="1"
                                CornerRadius="10" Padding="12,4">
                            <TextBox x:Name="txtEmail" Style="{StaticResource InputTextBox}"
                                     TextChanged="CredentialsChanged"/>
                        </Border>

                        <TextBlock Text="Senha" FontSize="12" FontWeight="Bold"
                                   Foreground="#34495A" Margin="0,16,0,7"/>
                        <Border Background="#F8FAFC" BorderBrush="#DCE6EB" BorderThickness="1"
                                CornerRadius="10" Padding="12,4">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <PasswordBox x:Name="txtPasswordClose" Style="{StaticResource InputPasswordBox}"
                                             PasswordChanged="CredentialsChanged"/>
                                <TextBox x:Name="txtPasswordOpen" Grid.Column="0" Style="{StaticResource InputTextBox}"
                                         Visibility="Collapsed" TextChanged="CredentialsChanged"/>
                                <Button Grid.Column="1" Style="{StaticResource BrandLinkButton}"
                                        Click="TogglePassword_Click" ToolTip="Mostrar ou ocultar senha">
                                    <Image x:Name="imgEye" Source="/IMG/eyeCloseIcon.png" Width="22" Height="22" Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Grid Margin="0,17,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,7,0">
                                <TextBlock Text="Loja" FontSize="12" FontWeight="Bold" Foreground="#34495A" Margin="0,0,0,7"/>
                                <Border Background="#F8FAFC" BorderBrush="#DCE6EB" BorderThickness="1" CornerRadius="10" Padding="10,2">
                                    <ComboBox x:Name="store" Style="{StaticResource StoreComboBox}"
                                              DisplayMemberPath="Name" SelectedValuePath="StoreId"
                                              SelectionChanged="loja_SelectionChanged"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                <TextBlock Text="Terminal" FontSize="12" FontWeight="Bold" Foreground="#34495A" Margin="0,0,0,7"/>
                                <Border Background="#F8FAFC" BorderBrush="#DCE6EB" BorderThickness="1" CornerRadius="10" Padding="10,2">
                                    <ComboBox x:Name="terminal" Style="{StaticResource StoreComboBox}"
                                              DisplayMemberPath="Name" SelectedValuePath="TerminalCode"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Button Background="#EB7A24" Foreground="#102A43" BorderThickness="0"
                                Padding="0,14" Margin="0,23,0,0" Cursor="Hand" Click="LogIn_Click">
                            <Button.Template><ControlTemplate TargetType="Button">
                                <Border x:Name="StartSurface" Background="{TemplateBinding Background}" CornerRadius="11"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="StartSurface" Property="Background" Value="#F29448"/>
                                </Trigger></ControlTemplate.Triggers>
                            </ControlTemplate></Button.Template>
                            <TextBlock Text="Iniciar turno" FontSize="16" FontWeight="Bold" Foreground="#102A43"/>
                        </Button>
                        <Button Style="{StaticResource BrandLinkButton}" HorizontalAlignment="Center" Margin="0,14,0,0"
                                Click="HelpButton_Click">
                            <TextBlock Text="Precisa de ajuda? Fale conosco pelo WhatsApp" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
